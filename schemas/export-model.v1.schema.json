{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyu.edu/vpat-analyzer/schemas/export-model.v1.schema.json",
  "title": "VPAT Analyzer export model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "outputFolder", "analysisStatus", "source", "provenance", "scoreSummary", "tabs"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "outputFolder": {"const": "My Drive/VPAT Analyzer Results"},
    "analysisStatus": {"enum": ["Complete", "Incomplete"]},
    "source": {"$ref": "#/$defs/source"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "scoreSummary": {
      "oneOf": [
        {"$ref": "#/$defs/completeScore"},
        {"$ref": "#/$defs/incompleteScore"}
      ]
    },
    "tabs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/overviewTab"},
        {"$ref": "#/$defs/lineItemTab"},
        {"$ref": "#/$defs/qualityTab"},
        {"$ref": "#/$defs/scoringTab"},
        {"$ref": "#/$defs/methodologyTab"}
      ],
      "items": false
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "sourceType", "vpatVersion", "declaredWcagVersions", "declaredLevels"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1, "maxLength": 512},
        "sourceType": {"enum": ["google-doc", "docx", "pdf"]},
        "vpatVersion": {"const": "2.5"},
        "declaredWcagVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["2.0", "2.1", "2.2"]}
        },
        "declaredLevels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["A", "AA", "AAA"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogVersion", "rubricVersion", "scoringVersion", "conformancePromptVersion", "qualityPromptVersion", "conformanceSchemaVersion", "qualitySchemaVersion", "ingestionSchemaVersion", "exportSchemaVersion", "templateVersion"],
      "properties": {
        "catalogVersion": {"const": "1.0.0"},
        "rubricVersion": {"const": "1.0.0"},
        "scoringVersion": {"const": "1.0.0"},
        "conformancePromptVersion": {"const": "1.0.0"},
        "qualityPromptVersion": {"const": "1.0.0"},
        "conformanceSchemaVersion": {"const": "1.0.0"},
        "qualitySchemaVersion": {"const": "1.0.0"},
        "ingestionSchemaVersion": {"const": "1.0.0"},
        "exportSchemaVersion": {"const": "1.0.0"},
        "templateVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "completeScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "earnedWeight", "possibleWeight", "percentage", "grade"],
      "properties": {
        "status": {"const": "Complete"},
        "earnedWeight": {"type": "integer", "minimum": 0, "maximum": 60},
        "possibleWeight": {"const": 60},
        "percentage": {"type": "integer", "minimum": 0, "maximum": 100},
        "grade": {"enum": ["F", "D", "C", "B", "A-", "A"]}
      }
    },
    "incompleteScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "earnedWeight", "possibleWeight", "percentage", "grade", "incompleteReasons"],
      "properties": {
        "status": {"const": "Incomplete"},
        "earnedWeight": {"type": "null"},
        "possibleWeight": {"type": "null"},
        "percentage": {"type": "null"},
        "grade": {"type": "null"},
        "incompleteReasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["INGESTION_ERROR", "MISSING_FINDING", "PROVIDER_ERROR", "MALFORMED_RESPONSE", "EXPORT_ERROR"]}
        }
      }
    },
    "literalCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columnId", "kind", "value"],
      "properties": {
        "columnId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "kind": {"const": "literal"},
        "value": {"type": ["string", "number", "boolean", "null"]}
      }
    },
    "formulaReferenceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columnId", "kind", "templateFormulaId"],
      "properties": {
        "columnId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "kind": {"const": "trusted-template-formula-reference"},
        "templateFormulaId": {"type": "string", "pattern": "^formula-[a-z0-9-]+-v[0-9]+$"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowId", "cells"],
      "properties": {
        "rowId": {"type": "string", "minLength": 1, "maxLength": 160},
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/literalCell"},
              {"$ref": "#/$defs/formulaReferenceCell"}
            ]
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "heading", "kind", "columns", "rows"],
      "properties": {
        "sectionId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "heading": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["summary", "table", "scoring", "methodology", "disclaimer"]},
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "rows": {
          "type": "array",
          "items": {"$ref": "#/$defs/row"}
        }
      }
    },
    "overviewTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabId", "name", "order", "sections"],
      "properties": {
        "tabId": {"const": "overview"},
        "name": {"const": "Overview"},
        "order": {"const": 1},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
      }
    },
    "lineItemTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabId", "name", "order", "sections"],
      "properties": {
        "tabId": {"const": "line-item-review"},
        "name": {"const": "Line-item Review"},
        "order": {"const": 2},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
      }
    },
    "qualityTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabId", "name", "order", "sections"],
      "properties": {
        "tabId": {"const": "quality-requirements"},
        "name": {"const": "Quality Requirements"},
        "order": {"const": 3},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
      }
    },
    "scoringTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabId", "name", "order", "sections"],
      "properties": {
        "tabId": {"const": "scoring"},
        "name": {"const": "Scoring"},
        "order": {"const": 4},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
      }
    },
    "methodologyTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabId", "name", "order", "sections"],
      "properties": {
        "tabId": {"const": "methodology-disclaimer"},
        "name": {"const": "Methodology & disclaimer"},
        "order": {"const": 5},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
      }
    }
  }
}
