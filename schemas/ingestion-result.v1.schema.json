{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyu.edu/vpat-analyzer/schemas/ingestion-result.v1.schema.json",
  "title": "VPAT Analyzer deterministic ingestion result v1",
  "oneOf": [
    {"$ref": "#/$defs/completeResult"},
    {"$ref": "#/$defs/rejectedResult"}
  ],
  "$defs": {
    "completeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "parserVersion", "catalogVersion", "sourceType", "status", "candidateTables", "rows", "excludedRows", "duplicates", "coverage"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
        "parserVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "catalogVersion": {"const": "1.0.0"},
        "sourceType": {"enum": ["google-doc", "docx", "pdf"]},
        "status": {"const": "complete"},
        "candidateTables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidateTable"}},
        "rows": {"type": "array", "minItems": 1, "maxItems": 87, "items": {"$ref": "#/$defs/extractedRow"}},
        "excludedRows": {"type": "array", "items": {"$ref": "#/$defs/excludedRow"}},
        "duplicates": {"type": "array", "items": {"$ref": "#/$defs/duplicateGroup"}},
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    },
    "rejectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "parserVersion", "catalogVersion", "sourceType", "status", "rejection"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
        "parserVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "catalogVersion": {"const": "1.0.0"},
        "sourceType": {"enum": ["google-doc", "docx", "pdf", "unknown"]},
        "status": {"const": "rejected"},
        "rejection": {"$ref": "#/$defs/rejection"}
      }
    },
    "candidateTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableId", "sourceOrder", "classification", "reasonCode", "headers"],
      "properties": {
        "tableId": {"type": "string", "minLength": 1, "maxLength": 128},
        "sourceOrder": {"type": "integer", "minimum": 0},
        "classification": {"enum": ["wcag", "non-wcag", "ambiguous"]},
        "reasonCode": {"enum": ["ELIGIBLE_WCAG_HEADERS", "BODY_OR_LAYOUT_TABLE", "SECTION_508_TABLE", "EN_301_549_TABLE", "NON_WCAG_TABLE", "AMBIGUOUS_HEADERS"]},
        "headers": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 500}}
      }
    },
    "extractedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowId", "criterionId", "sourceCriterionLabel", "sourceConformance", "sourceRemarks", "sourceTableIndex", "sourceRowIndex", "aliasMatch"],
      "properties": {
        "rowId": {"type": "string", "minLength": 1, "maxLength": 160},
        "criterionId": {"type": "string", "pattern": "^wcag-sc-[1-4]\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
        "sourceCriterionLabel": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sourceConformance": {"type": "string", "maxLength": 2000},
        "sourceRemarks": {"type": "string", "maxLength": 10000},
        "sourceTableIndex": {"type": "integer", "minimum": 0},
        "sourceRowIndex": {"type": "integer", "minimum": 0},
        "aliasMatch": {"enum": ["exact-sc", "exact-sc-plus-official-title"]}
      }
    },
    "excludedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTableIndex", "sourceRowIndex", "sourceLabel", "reasonCode"],
      "properties": {
        "sourceTableIndex": {"type": "integer", "minimum": 0},
        "sourceRowIndex": {"type": "integer", "minimum": 0},
        "sourceLabel": {"type": "string", "maxLength": 1000},
        "reasonCode": {"enum": ["BODY_PROSE", "NON_WCAG_ROW", "SECTION_508_ROW", "EN_301_549_ROW", "UNRECOGNIZED_CRITERION", "AMBIGUOUS_CRITERION", "DUPLICATE_CRITERION"]}
      }
    },
    "duplicateGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "keptRowId", "duplicateRowIds"],
      "properties": {
        "criterionId": {"type": "string", "pattern": "^wcag-sc-[1-4]\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
        "keptRowId": {"type": "string", "minLength": 1, "maxLength": 160},
        "duplicateRowIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaredWcagVersions", "declaredLevels", "expectedCriterionIds", "extractedCriterionIds", "missingCriterionIds"],
      "properties": {
        "declaredWcagVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["2.0", "2.1", "2.2"]}},
        "declaredLevels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["A", "AA", "AAA"]}},
        "expectedCriterionIds": {"type": "array", "minItems": 1, "maxItems": 87, "uniqueItems": true, "items": {"type": "string", "pattern": "^wcag-sc-[1-4]\\.[1-9][0-9]*\\.[1-9][0-9]*$"}},
        "extractedCriterionIds": {"type": "array", "minItems": 1, "maxItems": 87, "uniqueItems": true, "items": {"type": "string", "pattern": "^wcag-sc-[1-4]\\.[1-9][0-9]*\\.[1-9][0-9]*$"}},
        "missingCriterionIds": {"type": "array", "maxItems": 87, "uniqueItems": true, "items": {"type": "string", "pattern": "^wcag-sc-[1-4]\\.[1-9][0-9]*\\.[1-9][0-9]*$"}}
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "safeMessage"],
      "properties": {
        "code": {"enum": ["SOURCE_INACCESSIBLE", "SOURCE_TYPE_UNSUPPORTED", "VPAT_VERSION_UNSUPPORTED", "PDF_NON_SEARCHABLE", "PDF_INSUFFICIENT_TEXT", "PDF_ENCRYPTED", "SOURCE_MALFORMED", "WCAG_TABLE_NOT_FOUND", "WCAG_ROWS_AMBIGUOUS", "RESOURCE_LIMIT_EXCEEDED"]},
        "stage": {"enum": ["access", "classification", "transport", "container-parse", "table-detection", "row-matching", "resource-limit"]},
        "safeMessage": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
