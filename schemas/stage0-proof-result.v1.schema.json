{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyu.edu/vpat-analyzer/schemas/stage0-proof-result.v1.schema.json",
  "title": "VPAT Analyzer Stage 0 browser proof summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "proofMode",
    "status",
    "assertions",
    "build",
    "executionIdentity",
    "fixtureBindings",
    "cases",
    "rejectionMatrix",
    "runtime",
    "transport",
    "deadline",
    "memory",
    "csp",
    "browserNetwork",
    "guardedNetwork",
    "accessibility",
    "console",
    "privacyScan",
    "containsDeploymentBinding",
    "containsDriveIds",
    "containsSourceContent"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "generatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "proofMode": {"enum": ["live", "local"]},
    "status": {"enum": ["passed", "failed"]},
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "expectedTotal"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "expectedTotal": {"type": "integer", "minimum": 1}
      }
    },
    "build": {"$ref": "#/$defs/buildBinding"},
    "executionIdentity": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "expectedAccessibleCount", "accessibleCount", "inaccessibleCount", "boundarySatisfied"],
          "properties": {
            "mode": {"const": "two-account-access-differential"},
            "expectedAccessibleCount": {"type": "integer", "minimum": 1},
            "accessibleCount": {"type": "integer", "minimum": 0},
            "inaccessibleCount": {"type": "integer", "minimum": 0},
            "boundarySatisfied": {"type": "boolean"}
          }
        }
      ]
    },
    "fixtureBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/fixtureBinding"}
    },
    "cases": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/caseEvidence"}
    },
    "rejectionMatrix": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/rejectionEvidence"}
    },
    "runtime": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parserVersion", "catalogVersion", "criterionCount", "pdfStrategy", "docxStrategy"],
          "properties": {
            "parserVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "catalogVersion": {"const": "1.0.0"},
            "criterionCount": {"const": 87},
            "pdfStrategy": {"const": "pdfjs-inline-in-process-worker"},
            "docxStrategy": {"const": "fflate-ooxml-allowlist"}
          }
        }
      ]
    },
    "transport": {"$ref": "#/$defs/transportEvidence"},
    "deadline": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "preemptiveDeadlineSupported", "allWithinObservedLimit"],
          "properties": {
            "mode": {"const": "observed-non-preemptive"},
            "preemptiveDeadlineSupported": {"const": false},
            "allWithinObservedLimit": {"type": "boolean"}
          }
        }
      ]
    },
    "memory": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "measurement",
            "sampleCount",
            "beforeBytes",
            "sampledPeakBytes",
            "afterBytes",
            "sampledGrowthBytes",
            "limitPeakBytes",
            "limitGrowthBytes",
            "withinLimit"
          ],
          "properties": {
            "supported": {"type": "boolean"},
            "measurement": {"const": "sampled-performance-memory-not-an-exact-peak"},
            "sampleCount": {"type": "integer", "minimum": 0},
            "beforeBytes": {"type": ["integer", "null"], "minimum": 0},
            "sampledPeakBytes": {"type": ["integer", "null"], "minimum": 0},
            "afterBytes": {"type": ["integer", "null"], "minimum": 0},
            "sampledGrowthBytes": {"type": ["integer", "null"], "minimum": 0},
            "limitPeakBytes": {"type": "integer", "minimum": 1},
            "limitGrowthBytes": {"type": "integer", "minimum": 1},
            "withinLimit": {"type": "boolean"}
          }
        }
      ]
    },
    "csp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["violationCount", "headerObserved", "metaObserved", "directiveNames", "workerDirectivePresent", "workerRequestCount", "serviceWorkerCount"],
      "properties": {
        "violationCount": {"type": "integer", "minimum": 0},
        "headerObserved": {"type": "boolean"},
        "metaObserved": {"type": "boolean"},
        "directiveNames": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "workerDirectivePresent": {"type": "boolean"},
        "workerRequestCount": {"type": "integer", "minimum": 0},
        "serviceWorkerCount": {"type": "integer", "minimum": 0}
      }
    },
    "browserNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestCount", "phaseCounts", "requestClassifications", "resourceTypes", "actionCounts", "unexpectedRequestCount", "blockedRequestCount"],
      "properties": {
        "requestCount": {"type": "integer", "minimum": 0},
        "phaseCounts": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/namedCount"}},
        "requestClassifications": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/namedCount"}},
        "resourceTypes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/namedCount"}},
        "actionCounts": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/namedCount"}},
        "unexpectedRequestCount": {"type": "integer", "minimum": 0},
        "blockedRequestCount": {"type": "integer", "minimum": 0}
      }
    },
    "guardedNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryCount", "capabilities", "apiCounts", "allowedCount", "unexpectedCount"],
      "properties": {
        "entryCount": {"type": "integer", "minimum": 0},
        "capabilities": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/guardCapability"}},
        "apiCounts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/namedCount"}},
        "allowedCount": {"type": "integer", "minimum": 0},
        "unexpectedCount": {"type": "integer", "minimum": 0}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentLanguage", "mainLandmark", "singleH1", "labeledResultsTable", "statusLiveRegion", "keyboardFocus", "visibleFocusIndicator", "minimumTargetSize", "keyboardActivation", "passed"],
      "properties": {
        "documentLanguage": {"type": "boolean"},
        "mainLandmark": {"type": "boolean"},
        "singleH1": {"type": "boolean"},
        "labeledResultsTable": {"type": "boolean"},
        "statusLiveRegion": {"type": "boolean"},
        "keyboardFocus": {"type": "boolean"},
        "visibleFocusIndicator": {"type": "boolean"},
        "minimumTargetSize": {"type": "boolean"},
        "keyboardActivation": {"type": "boolean"},
        "passed": {"type": "boolean"}
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "warning"],
      "properties": {
        "error": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0}
      }
    },
    "privacyScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "patternVersion", "fieldsScanned", "evidenceSha256"],
      "properties": {
        "method": {"const": "derived-regex-over-canonical-summary"},
        "patternVersion": {"const": "1.0.0"},
        "fieldsScanned": {"type": "integer", "minimum": 1},
        "evidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "containsDeploymentBinding": {"const": false},
    "containsDriveIds": {"const": false},
    "containsSourceContent": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "nullableString": {"type": ["string", "null"], "maxLength": 100},
    "buildBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "bundleSha256", "bundleBytes", "guardBundleSha256", "fixtureManifestSha256", "appsscriptManifestSha256", "goldenProjectionSpecSha256", "buildScriptSha256", "proofRunnerSha256", "proofSchemaSha256"],
      "properties": {
        "id": {"$ref": "#/$defs/sha256"},
        "version": {"const": "1.0.0"},
        "bundleSha256": {"$ref": "#/$defs/sha256"},
        "bundleBytes": {"type": "integer", "minimum": 1},
        "guardBundleSha256": {"$ref": "#/$defs/sha256"},
        "fixtureManifestSha256": {"$ref": "#/$defs/sha256"},
        "appsscriptManifestSha256": {"$ref": "#/$defs/sha256"},
        "goldenProjectionSpecSha256": {"$ref": "#/$defs/sha256"},
        "buildScriptSha256": {"$ref": "#/$defs/sha256"},
        "proofRunnerSha256": {"$ref": "#/$defs/sha256"},
        "proofSchemaSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fixtureBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseKey", "sourceType", "expectedStatus", "expectedCode", "fixtureSha256", "expectedBytes", "expectedChunkCount", "expectedProjectionSha256"],
      "properties": {
        "caseKey": {"type": "string", "minLength": 1, "maxLength": 100},
        "sourceType": {"enum": ["google-doc", "docx", "pdf", "unknown"]},
        "expectedStatus": {"enum": ["complete", "rejected"]},
        "expectedCode": {"$ref": "#/$defs/nullableString"},
        "fixtureSha256": {"$ref": "#/$defs/nullableSha256"},
        "expectedBytes": {"$ref": "#/$defs/nullableInteger"},
        "expectedChunkCount": {"$ref": "#/$defs/nullableInteger"},
        "expectedProjectionSha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "caseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseKey", "expectedStatus", "expectedCode", "observedStatus", "observedCode", "fixtureSha256", "byteLength", "chunkCount", "batchCount", "projectionSha256", "elapsedMs", "maxObservedDurationMs", "withinObservedDeadline", "passed"],
      "properties": {
        "caseKey": {"type": "string", "minLength": 1, "maxLength": 100},
        "expectedStatus": {"enum": ["complete", "rejected"]},
        "expectedCode": {"$ref": "#/$defs/nullableString"},
        "observedStatus": {"enum": ["complete", "rejected"]},
        "observedCode": {"$ref": "#/$defs/nullableString"},
        "fixtureSha256": {"$ref": "#/$defs/nullableSha256"},
        "byteLength": {"$ref": "#/$defs/nullableInteger"},
        "chunkCount": {"$ref": "#/$defs/nullableInteger"},
        "batchCount": {"$ref": "#/$defs/nullableInteger"},
        "projectionSha256": {"$ref": "#/$defs/nullableSha256"},
        "elapsedMs": {"type": "number", "minimum": 0},
        "maxObservedDurationMs": {"type": "integer", "minimum": 1},
        "withinObservedDeadline": {"type": "boolean"},
        "passed": {"type": "boolean"}
      }
    },
    "rejectionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseKey", "expectedCode", "observedCode", "passed"],
      "properties": {
        "caseKey": {"type": "string", "minLength": 1, "maxLength": 100},
        "expectedCode": {"type": "string", "minLength": 1, "maxLength": 100},
        "observedCode": {"$ref": "#/$defs/nullableString"},
        "passed": {"type": "boolean"}
      }
    },
    "transportEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunkBytes", "chunkBatchSize", "maxSourceBytes", "maxChunks", "maxJsonBytes", "driveBoundaryExercised", "batchCount", "multiChunkCaseCount", "multiChunkCases", "multiBatchCaseCount", "multiBatchCases"],
      "properties": {
        "chunkBytes": {"type": "integer", "minimum": 1024},
        "chunkBatchSize": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxSourceBytes": {"type": "integer", "minimum": 1},
        "maxChunks": {"type": "integer", "minimum": 1},
        "maxJsonBytes": {"type": "integer", "minimum": 1},
        "driveBoundaryExercised": {"type": "boolean"},
        "batchCount": {"type": "integer", "minimum": 0},
        "multiChunkCaseCount": {"type": "integer", "minimum": 0},
        "multiChunkCases": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
        "multiBatchCaseCount": {"type": "integer", "minimum": 0},
        "multiBatchCases": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
      }
    },
    "guardCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "available", "installed"],
      "properties": {
        "api": {"type": "string", "minLength": 1, "maxLength": 100},
        "available": {"type": "boolean"},
        "installed": {"type": "boolean"}
      }
    },
    "namedCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
